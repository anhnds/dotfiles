#!/usr/bin/env bash
# secrets-env: lấy biến môi trường từ 1Password cloud ra file cache cho shell và GUI app.
#
# Quy ước trong 1Password:
#   - Item gắn tag `shell-env`  -> mỗi field là 1 biến: tên field = tên biến (vd JFROG_TOKEN).
#   - Secure Note gắn tag `shell-env-refs` -> ghi chú là template, mỗi dòng TÊN=op://vault/item/[section/]field.
#     Dùng để lấy secret từ item bất kỳ (Login, API Credential...) và tự đặt tên biến. Dòng # bị bỏ qua.
#   - Item gắn thêm tag `gui-env` -> các biến đó cũng được `launchctl setenv` cho GUI app.
#   Field rỗng, field ghi chú, field có tên không hợp lệ làm tên biến -> bỏ qua.
#   Secret quan trọng (production...) không nên vào cache: dùng `op run --env-file=... -- lệnh`.
#
# Loại trừ theo máy (không nằm trong repo): ~/.config/secrets-env/exclude
#   Mỗi dòng là tên hoặc ID một item/note sẽ KHÔNG được nạp trên máy này (vd item của máy công ty).
#
# Lệnh:
#   secrets-env refresh   gọi op (cần app 1Password mở khoá), ghi cache, rồi chạy `launchd`
#   secrets-env launchd   đọc cache -> launchctl setenv biến gui-env
#   secrets-env auto      refresh có khoá + ghi mốc/log/cờ lỗi (dùng bởi terminal và lúc login)
#   secrets-env login     LaunchAgent lúc login: `launchd` ngay, chờ 10s (SECRETS_ENV_LOGIN_DELAY), rồi `auto`
#   secrets-env status    in tên biến (không in giá trị) + thời điểm cache
#   secrets-env clear     xoá cache + launchctl unsetenv
#
# File cache (NGOÀI repo dotfiles, quyền 600):
#   ~/.local/state/secrets/env.sh       export K='V'   (được ~/.zshenv source)
#   ~/.local/state/secrets/gui-vars     tên biến gui-env, mỗi dòng 1 tên
set -euo pipefail

STATE="${XDG_STATE_HOME:-$HOME/.local/state}/secrets"
CACHE="$STATE/env.sh"
GUI_LIST="$STATE/gui-vars"
STAMP="$STATE/last-sync"
AUTO_LOG="$STATE/auto-sync.log"
FAILED="$STATE/auto-sync.failed"
LOCK="$STATE/.auto-sync.lock"
SHELL_TAG="shell-env"
REFS_TAG="shell-env-refs"
GUI_TAG="gui-env"
EXCLUDE="${XDG_CONFIG_HOME:-$HOME/.config}/secrets-env/exclude"

export PATH="/opt/homebrew/bin:/usr/bin:/bin:$PATH"   # khi chạy từ launchd
die() { echo "secrets-env: $*" >&2; exit 1; }

cmd_refresh() {
  command -v op >/dev/null || die "chưa cài 1Password CLI (op)"
  command -v jq >/dev/null || die "chưa có jq"
  umask 077
  mkdir -p "$STATE"
  chmod 700 "$STATE"

  local ids ref_ids tmp gtmp
  # Danh sách loại trừ của máy này (tên hoặc ID, bỏ dòng trống và #)
  local excl='[]'
  if [ -r "$EXCLUDE" ]; then
    excl=$({ grep -v -E '^[[:space:]]*(#|$)' "$EXCLUDE" || true; } | sed 's/[[:space:]]*$//' | jq -R . | jq -s .)
  fi
  local pick='[.[] | select((.id as $i | .title as $t | $ex | index($i) or index($t)) | not) | .id] | .[]'
  local skipped='[.[] | select(.id as $i | .title as $t | $ex | index($i) or index($t)) | .title] | .[]'
  local list_s list_r
  list_s=$(op item list --tags "$SHELL_TAG" --format json)
  list_r=$(op item list --tags "$REFS_TAG" --format json)
  ids=$(jq -r --argjson ex "$excl" "$pick" <<<"$list_s")
  ref_ids=$(jq -r --argjson ex "$excl" "$pick" <<<"$list_r")
  { jq -r --argjson ex "$excl" "$skipped" <<<"$list_s"; jq -r --argjson ex "$excl" "$skipped" <<<"$list_r"; } |
    while IFS= read -r t; do [ -n "$t" ] && echo "secrets-env: bỏ qua '$t' (có trong $EXCLUDE)" >&2; done
  [ -n "$ids$ref_ids" ] || echo "secrets-env: không có item nào để nạp, cache sẽ rỗng." >&2

  tmp=$(mktemp "$STATE/.env.XXXXXX")
  gtmp=$(mktemp "$STATE/.gui.XXXXXX")
  trap 'rm -f "$tmp" "$gtmp"' EXIT
  printf '# Tạo bởi secrets-env refresh lúc %s. Không sửa tay.\n' "$(date '+%F %T')" > "$tmp"

  local id item title
  for id in $ids; do
    item=$(op item get "$id" --reveal --format json)
    title=$(jq -r '.title' <<<"$item")
    printf '\n# %s\n' "$title" >> "$tmp"
    jq -r '
      .fields[]
      | select(.label | test("^[A-Za-z_][A-Za-z0-9_]*$"))
      | select(.label != "notesPlain" and (.value // "") != "")
      | "export \(.label)=\(.value | @sh)"' <<<"$item" >> "$tmp"
    if jq -e --arg t "$GUI_TAG" '(.tags // []) | index($t)' <<<"$item" >/dev/null; then
      jq -r '
        .fields[]
        | select(.label | test("^[A-Za-z_][A-Za-z0-9_]*$"))
        | select(.label != "notesPlain" and (.value // "") != "")
        | .label' <<<"$item" >> "$gtmp"
    fi
  done

  # Template op:// trong Secure Note tag shell-env-refs: đọc từng tham chiếu bằng `op read`
  local line name ref val is_gui failed=0
  for id in $ref_ids; do
    item=$(op item get "$id" --format json)
    title=$(jq -r '.title' <<<"$item")
    is_gui=0
    jq -e --arg t "$GUI_TAG" '(.tags // []) | index($t)' <<<"$item" >/dev/null && is_gui=1
    printf '\n# %s (op:// refs)\n' "$title" >> "$tmp"
    while IFS= read -r line; do
      line="${line%$'\r'}"
      case "$line" in ''|'#'*) continue ;; esac
      name="${line%%=*}"; ref="${line#*=}"
      if ! [[ "$name" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || [[ "$ref" != op://* ]]; then
        echo "secrets-env: bỏ qua dòng không hợp lệ trong '$title': ${name:0:40}=... (cần dạng TÊN=op://vault/item/field; không ghi giá trị thẳng vào note)" >&2; continue
      fi
      if ! val=$(op read --no-newline "$ref" 2>/dev/null); then
        echo "secrets-env: không đọc được $name ($ref)" >&2; failed=1; continue
      fi
      printf 'export %s=%s\n' "$name" "$(jq -rn --arg v "$val" '$v | @sh')" >> "$tmp"
      [ "$is_gui" = 1 ] && echo "$name" >> "$gtmp"
    done < <(jq -r '.fields[] | select(.label == "notesPlain") | .value // ""' <<<"$item")
  done
  val=""
  [ "$failed" = 0 ] || echo "secrets-env: có tham chiếu lỗi ở trên, các biến khác vẫn được ghi." >&2

  local dups
  dups=$({ grep -o '^export [A-Za-z0-9_]*' "$tmp" || true; } | sort | uniq -d | cut -d' ' -f2 | tr '\n' ' ')
  [ -z "$dups" ] || echo "secrets-env: cảnh báo, biến bị trùng giữa các item (item sau thắng): $dups" >&2

  # Gỡ biến GUI cũ không còn trong danh sách mới
  if [ -f "$GUI_LIST" ]; then
    local old
    while read -r old; do
      [ -n "$old" ] && ! grep -qx "$old" "$gtmp" && launchctl unsetenv "$old" 2>/dev/null || true
    done < "$GUI_LIST"
  fi

  mv "$tmp" "$CACHE"
  sort -u "$gtmp" > "$GUI_LIST"; rm -f "$gtmp"
  trap - EXIT
  cmd_launchd
  echo "secrets-env: đã ghi $(grep -c '^export ' "$CACHE" || true) biến vào $CACHE ($(wc -l < "$GUI_LIST" | tr -d ' ') biến cho GUI app)."
  echo "secrets-env: mở shell mới (exec zsh) để nhận biến."
}

cmd_launchd() {
  [ -r "$CACHE" ] || { echo "secrets-env: chưa có cache, chạy: secrets-env refresh" >&2; return 0; }
  [ -s "$GUI_LIST" ] || return 0
  # Đọc cache trong subshell rồi chỉ setenv các biến gui-env
  (
    # shellcheck disable=SC1090
    . "$CACHE"
    while read -r name; do
      [ -n "$name" ] && [ -n "${!name:-}" ] && launchctl setenv "$name" "${!name}"
    done < "$GUI_LIST"
  )
}

# Refresh tự động: khoá để không chạy trùng (terminal + login), ghi mốc thời gian, log và cờ lỗi.
cmd_auto() {
  local reason="${1:-auto}"
  mkdir -p "$STATE"
  # Khoá kẹt quá 10 phút (process bị kill) -> gỡ
  if [ -d "$LOCK" ] && [ -n "$(find "$LOCK" -maxdepth 0 -mmin +10 2>/dev/null)" ]; then rmdir "$LOCK" 2>/dev/null || true; fi
  mkdir "$LOCK" 2>/dev/null || { echo "secrets-env: đang có lần sync khác chạy, bỏ qua" >&2; return 0; }
  trap 'rmdir "$LOCK" 2>/dev/null || true' EXIT
  touch "$STAMP"
  {
    echo "== $(date '+%F %T') $reason"
    # Process riêng: trong `if`, bash tắt set -e, op lỗi có thể ghi đè cache bằng bản rỗng
    if "$0" refresh; then rm -f "$FAILED"; else touch "$FAILED"; fi
  } >>"$AUTO_LOG" 2>&1
  rmdir "$LOCK" 2>/dev/null || true
  trap - EXIT
}

cmd_login() {
  cmd_launchd || true     # GUI app nhận biến từ cache ngay, không cần op
  sleep "${SECRETS_ENV_LOGIN_DELAY:-10}"   # chờ app 1Password khởi động xong
  cmd_auto "login"
}

cmd_status() {
  if [ ! -r "$CACHE" ]; then echo "Chưa có cache. Chạy: secrets-env refresh"; return; fi
  echo "Cache: $CACHE (cập nhật $(stat -f '%Sm' -t '%F %T' "$CACHE"))"
  local gui=""; [ -r "$GUI_LIST" ] && gui=$(cat "$GUI_LIST")
  { grep -o '^export [A-Za-z0-9_]*' "$CACHE" || echo "  (không có biến nào)" >&2; } | cut -d' ' -f2 | while read -r n; do
    if grep -qx "$n" <<<"$gui"; then echo "  $n  (shell + gui)"; else echo "  $n"; fi
  done
}

cmd_clear() {
  if [ -r "$GUI_LIST" ]; then
    while read -r n; do [ -n "$n" ] && launchctl unsetenv "$n" 2>/dev/null || true; done < "$GUI_LIST"
  fi
  rm -f "$CACHE" "$GUI_LIST"
  echo "secrets-env: đã xoá cache. Mở shell mới để bỏ biến khỏi môi trường."
}

case "${1:-}" in
  refresh) cmd_refresh ;;
  launchd) cmd_launchd ;;
  auto)    cmd_auto ;;
  login)   cmd_login ;;
  status)  cmd_status ;;
  clear)   cmd_clear ;;
  *) sed -n '2,22p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac
