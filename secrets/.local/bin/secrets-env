#!/usr/bin/env bash
# secrets-env: lấy biến môi trường từ 1Password cloud ra file cache cho shell và GUI app.
#
# Quy ước trong 1Password:
#   - Item gắn tag `shell-env`  -> mỗi field là 1 biến: tên field = tên biến (vd JFROG_TOKEN).
#   - Secure Note gắn tag `shell-env-refs` -> ghi chú là template, mỗi dòng TÊN=op://vault/item/[section/]field.
#     Dùng để lấy secret từ item bất kỳ (Login, API Credential...) và tự đặt tên biến. Dòng # bị bỏ qua.
#   - Item gắn thêm tag `gui-env` -> các biến đó cũng được `launchctl setenv` cho GUI app.
#   Field rỗng, field ghi chú, field có tên không hợp lệ làm tên biến -> bỏ qua.
#   Secret quan trọng (production...) không nên vào cache: dùng `op run --env-file=... -- lệnh`.
#
# Lệnh:
#   secrets-env refresh   gọi op (cần app 1Password mở khoá), ghi cache, rồi chạy `launchd`
#   secrets-env launchd   đọc cache -> launchctl setenv biến gui-env (LaunchAgent chạy lúc login)
#   secrets-env status    in tên biến (không in giá trị) + thời điểm cache
#   secrets-env clear     xoá cache + launchctl unsetenv
#
# File cache (NGOÀI repo dotfiles, quyền 600):
#   ~/.local/state/secrets/env.sh       export K='V'   (được ~/.zshenv source)
#   ~/.local/state/secrets/gui-vars     tên biến gui-env, mỗi dòng 1 tên
set -euo pipefail

STATE="${XDG_STATE_HOME:-$HOME/.local/state}/secrets"
CACHE="$STATE/env.sh"
GUI_LIST="$STATE/gui-vars"
SHELL_TAG="shell-env"
REFS_TAG="shell-env-refs"
GUI_TAG="gui-env"

export PATH="/opt/homebrew/bin:/usr/bin:/bin:$PATH"   # khi chạy từ launchd
die() { echo "secrets-env: $*" >&2; exit 1; }

cmd_refresh() {
  command -v op >/dev/null || die "chưa cài 1Password CLI (op)"
  command -v jq >/dev/null || die "chưa có jq"
  umask 077
  mkdir -p "$STATE"
  chmod 700 "$STATE"

  local ids ref_ids tmp gtmp
  ids=$(op item list --tags "$SHELL_TAG" --format json | jq -r '.[].id')
  ref_ids=$(op item list --tags "$REFS_TAG" --format json | jq -r '.[].id')
  [ -n "$ids$ref_ids" ] || die "không có item nào gắn tag '$SHELL_TAG' hoặc '$REFS_TAG'"

  tmp=$(mktemp "$STATE/.env.XXXXXX")
  gtmp=$(mktemp "$STATE/.gui.XXXXXX")
  trap 'rm -f "$tmp" "$gtmp"' EXIT
  printf '# Tạo bởi secrets-env refresh lúc %s. Không sửa tay.\n' "$(date '+%F %T')" > "$tmp"

  local id item title
  for id in $ids; do
    item=$(op item get "$id" --reveal --format json)
    title=$(jq -r '.title' <<<"$item")
    printf '\n# %s\n' "$title" >> "$tmp"
    jq -r '
      .fields[]
      | select(.label | test("^[A-Za-z_][A-Za-z0-9_]*$"))
      | select(.label != "notesPlain" and (.value // "") != "")
      | "export \(.label)=\(.value | @sh)"' <<<"$item" >> "$tmp"
    if jq -e --arg t "$GUI_TAG" '(.tags // []) | index($t)' <<<"$item" >/dev/null; then
      jq -r '
        .fields[]
        | select(.label | test("^[A-Za-z_][A-Za-z0-9_]*$"))
        | select(.label != "notesPlain" and (.value // "") != "")
        | .label' <<<"$item" >> "$gtmp"
    fi
  done

  # Template op:// trong Secure Note tag shell-env-refs: đọc từng tham chiếu bằng `op read`
  local line name ref val is_gui failed=0
  for id in $ref_ids; do
    item=$(op item get "$id" --format json)
    title=$(jq -r '.title' <<<"$item")
    is_gui=0
    jq -e --arg t "$GUI_TAG" '(.tags // []) | index($t)' <<<"$item" >/dev/null && is_gui=1
    printf '\n# %s (op:// refs)\n' "$title" >> "$tmp"
    while IFS= read -r line; do
      line="${line%$'\r'}"
      case "$line" in ''|'#'*) continue ;; esac
      name="${line%%=*}"; ref="${line#*=}"
      if ! [[ "$name" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || [[ "$ref" != op://* ]]; then
        echo "secrets-env: bỏ qua dòng không hợp lệ trong '$title': ${name:0:40}=..." >&2; continue
      fi
      if ! val=$(op read --no-newline "$ref" 2>/dev/null); then
        echo "secrets-env: không đọc được $name ($ref)" >&2; failed=1; continue
      fi
      printf 'export %s=%s\n' "$name" "$(jq -rn --arg v "$val" '$v | @sh')" >> "$tmp"
      [ "$is_gui" = 1 ] && echo "$name" >> "$gtmp"
    done < <(jq -r '.fields[] | select(.label == "notesPlain") | .value // ""' <<<"$item")
  done
  val=""
  [ "$failed" = 0 ] || echo "secrets-env: có tham chiếu lỗi ở trên, các biến khác vẫn được ghi." >&2

  local dups
  dups=$(grep -o '^export [A-Za-z0-9_]*' "$tmp" | sort | uniq -d | cut -d' ' -f2 | tr '\n' ' ')
  [ -z "$dups" ] || echo "secrets-env: cảnh báo, biến bị trùng giữa các item (item sau thắng): $dups" >&2

  # Gỡ biến GUI cũ không còn trong danh sách mới
  if [ -f "$GUI_LIST" ]; then
    local old
    while read -r old; do
      [ -n "$old" ] && ! grep -qx "$old" "$gtmp" && launchctl unsetenv "$old" 2>/dev/null || true
    done < "$GUI_LIST"
  fi

  mv "$tmp" "$CACHE"
  sort -u "$gtmp" > "$GUI_LIST"; rm -f "$gtmp"
  trap - EXIT
  cmd_launchd
  echo "secrets-env: đã ghi $(grep -c '^export ' "$CACHE") biến vào $CACHE ($(wc -l < "$GUI_LIST" | tr -d ' ') biến cho GUI app)."
  echo "secrets-env: mở shell mới (exec zsh) để nhận biến."
}

cmd_launchd() {
  [ -r "$CACHE" ] || { echo "secrets-env: chưa có cache, chạy: secrets-env refresh" >&2; return 0; }
  [ -s "$GUI_LIST" ] || return 0
  # Đọc cache trong subshell rồi chỉ setenv các biến gui-env
  (
    # shellcheck disable=SC1090
    . "$CACHE"
    while read -r name; do
      [ -n "$name" ] && [ -n "${!name:-}" ] && launchctl setenv "$name" "${!name}"
    done < "$GUI_LIST"
  )
}

cmd_status() {
  if [ ! -r "$CACHE" ]; then echo "Chưa có cache. Chạy: secrets-env refresh"; return; fi
  echo "Cache: $CACHE (cập nhật $(stat -f '%Sm' -t '%F %T' "$CACHE"))"
  local gui=""; [ -r "$GUI_LIST" ] && gui=$(cat "$GUI_LIST")
  grep -o '^export [A-Za-z0-9_]*' "$CACHE" | cut -d' ' -f2 | while read -r n; do
    if grep -qx "$n" <<<"$gui"; then echo "  $n  (shell + gui)"; else echo "  $n"; fi
  done
}

cmd_clear() {
  if [ -r "$GUI_LIST" ]; then
    while read -r n; do [ -n "$n" ] && launchctl unsetenv "$n" 2>/dev/null || true; done < "$GUI_LIST"
  fi
  rm -f "$CACHE" "$GUI_LIST"
  echo "secrets-env: đã xoá cache. Mở shell mới để bỏ biến khỏi môi trường."
}

case "${1:-}" in
  refresh) cmd_refresh ;;
  launchd) cmd_launchd ;;
  status)  cmd_status ;;
  clear)   cmd_clear ;;
  *) sed -n '2,17p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac
