<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Lúc login: launchctl setenv biến gui-env từ cache (ngay), chờ 10s, rồi refresh từ 1Password (có thể hỏi Touch ID).
     Xem: secrets-env (dotfiles/secrets/.local/bin/secrets-env) -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>dev.anhnds.secrets-env</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>-c</string>
    <string>exec "$HOME/.local/bin/secrets-env" login</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardErrorPath</key>
  <string>/tmp/dev.anhnds.secrets-env.log</string>
</dict>
</plist>
