# ~/.config/git/config  (symlink -> dotfiles/git/.config/git/config)
[user]
	name = Nguyen Duy Anh
	email = anh.ndns@gmail.com
	signingkey = ssh-rsa 
[init]
	defaultBranch = main
[pull]
	rebase = true
[push]
	autoSetupRemote = true
[core]
	editor = nvim
# Global ignore: ~/.config/git/ignore (git tự đọc, không cần khai báo)
[gpg]
	format = ssh
[gpg "ssh"]
	program = /Applications/1Password.app/Contents/MacOS/op-ssh-sign
[commit]
	gpgsign = true
